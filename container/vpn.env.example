# Settings for rdp-vpn.service (openconnect).
# Normally written by rdp-vpn-setup. After editing by hand:
#   sudo systemctl restart rdp-vpn
VPN_SERVER=vpn.example.com
VPN_USER=your.name
VPN_PROTOCOL=anyconnect
# Further openconnect options, separated by spaces, e.g.
#   --authgroup=Employees
#   --servercert=pin-sha256:...   (if the server certificate is not publicly trusted)
VPN_EXTRA_ARGS=""
